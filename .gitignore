.venv/
__pycache__/
*.pyc
.env
# The CLI default --out at the repo root. Rooted: unrooted `out/` also
# matched assets/out/, the session library, which is meant to be committed.
/out/
segments.json

# The local job store: uploads, working audio, and every result.json. Rooted
# on purpose - `data/` unrooted also matched `site/data/`, which is the
# published output and is meant to be committed.
/data/

# Recordings waiting to be processed. The source audio is committed alongside
# the analyses it produces in assets/out, so a clone can rerun the pipeline
# from scratch. Anything else the directory collects stays local.
/assets/in/*
!/assets/in/.gitkeep
!/assets/in/*.mp3
!/assets/in/*.m4a
!/assets/in/*.wav
!/assets/in/*.flac
!/assets/in/*.ogg

# A session directory is result.json and transcript.txt. Everything else the
# pipeline writes into it is an intermediate - audio_16k.wav is the normalized
# waveform and runs to ~120MB for a 64-minute lesson, which is over GitHub's
# hard 100MB file limit and is reconstructible from the source audio anyway.
/assets/out/*/*
!/assets/out/*/result.json
!/assets/out/*/transcript.txt
