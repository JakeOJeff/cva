# Speaker diarization (required).
# 1. Accept the terms once at https://hf.co/pyannote/speaker-diarization-community-1
# 2. Create a read token at https://hf.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# AI teaching review (optional - metrics still work without it).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional
# CVA_DATA_DIR=./data
# CVA_MAX_UPLOAD_MB=500

# Diarization checkpoint. Only set this if you have access to a different one
# than the default pyannote/speaker-diarization-community-1.
# CVA_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Set a password before exposing this beyond localhost. Without it the server
# has NO authentication and anyone with the URL can upload audio and read
# every transcript.
# CVA_USERNAME=teacher
# CVA_PASSWORD=pick-something-long

# Transcription + diarization backend: local (default) or scribe.
#   local   faster-whisper + pyannote on this machine. Free, private, slow.
#   scribe  ElevenLabs Scribe v2 - one request does both, far more accurate
#           on Indian languages, but paid and the audio leaves the machine.
# CVA_BACKEND=scribe
# ELEVENLABS_API_KEY=sk_...
